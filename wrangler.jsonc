{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kompak-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "API_BASE_URL": "https://kompak-api.muriz.workers.dev",
    "CORS_ORIGINS": "http://localhost:3000",
    "S3_ENDPOINT": "https://ea73e5f4991033f74b7c1637db79a566.r2.cloudflarestorage.com",
    "S3_REGION": "auto",
    "S3_BUCKET_NAME": "kompak-s3",
    "R2_PUBLIC_URL": "https://kompak-api.muriz.workers.dev/storage"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "96312d5b48234ffebdf67f661766bc1b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kompak-s3"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kompak-db",
      "database_id": "f675d542-00d0-4bb4-b667-7e26cdcfc145",
      "migrations_dir": "drizzle",
      "remote": true
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}